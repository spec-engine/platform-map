{
  "name": "@spec-engine/platform-map",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "description": "Zero-dependency TypeScript library + CLI that deterministically maps a directory tree's platform topology (units, edges, diagnostics).",
  "keywords": [
    "monorepo",
    "workspace",
    "topology",
    "platform",
    "dependency-graph",
    "pnpm",
    "yarn",
    "npm-workspaces",
    "lerna",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spec-engine/platform-map.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "platform-map": "dist/platform-map.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.*",
    "dist/platform-map.*",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --test --test-concurrency=4",
    "demo": "npm run build && node scripts/demo-platform.mjs",
    "test:bun": "bun test test-bun/",
    "smoke:cold-install": "npm run build && node scripts/cold-install-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "lint:docs": "node scripts/check-public-docs.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^20.19.43",
    "publint": "^0.3.21",
    "tsdown": "^0.22.7",
    "typescript": "^7.0.2"
  }
}
